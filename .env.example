# Google Maps Platform API key. Required APIs:
#   Maps SDK for Android, Maps SDK for iOS (optional), Places API (New), Routes API, Geocoding API
GOOGLE_MAPS_API_KEY=
# 1 = use Google Maps renderer on iOS too (default: Apple Maps / MapKit)
IOS_GOOGLE_MAPS=0
# SHA-1 of your Android signing certificate (only if the key is restricted to Android apps)
ANDROID_CERT_SHA1=
